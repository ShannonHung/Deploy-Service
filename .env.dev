APP_ENV=dev
APP_NAME="Deploy Service"
APP_VERSION="0.1.0"
DEBUG=true
LOG_LEVEL=DEBUG

# JWT
SECRET_KEY=dev-secret-key-change-in-production-minimum-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Users store
USERS_JSON_PATH=data/users.json

# GitLab
GITLAB_URL=https://gitlab.com/
GITLAB_TOKEN=
GITLAB_PROJECT_ID=79912706
GITLAB_AUTH_JSON_PATH=data/gitlab_auth.json

# redis
REDIS_URL="redis://:your_strong_password@localhost:6379/0"

# Inventory API (fake one runs locally on :9001 via `make inventory-api`)
INVENTORY_API_URL=https://localhost:9001
INVENTORY_API_TOKEN=fake-inventory-token
INVENTORY_API_TIMEOUT_SECONDS=5
INVENTORY_API_VERIFY_SSL=false
INVENTORY_CA=data/ca.crt

# Cluster / Bastion mapping API (same fake-api process as inventory)
CLUSTER_API_URL=http://localhost:9001
CLUSTER_API_TOKEN=fake-cluster-token
CLUSTER_API_TIMEOUT_SECONDS=5
BASTION_NODE_TYPE_MAP={"baremetal": "type1", "virtual-machine": "type2"}
CLUSTER_SLASH_TYPE_MAP={"no_slash": "type1", "with_slash": "type2"}

# Dry-run (e2e pipeline testing) — see docs/arch/dry-run-mode.md
# When true, GitLab pipelines are not triggered and SSH commands are not
# executed; auth, validation and business logic still run, and every response
# carries "dry_run": true. Refused at startup when APP_ENV=prod.
DRY_RUN_MODE=false

# How long a dry-run command pretends to run. 0 = finishes immediately.
# Raise it to exercise the kill path (RUNNING -> KILLING -> KILLED), which
# is unreachable when a command is terminal before the kill arrives.
DRY_RUN_COMMAND_SECONDS=0
