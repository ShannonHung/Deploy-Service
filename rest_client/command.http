@base_url = http://localhost:8001
@admin_user = admin
@admin_pass = password

### Get Token
# @name login
POST {{base_url}}/token
Content-Type: application/x-www-form-urlencoded

username={{admin_user}}&password={{admin_pass}}


### Store the access token from the login response
@token = {{login.response.body.access_token}}

### Get All Commands Info
GET {{base_url}}/api/v1/command/info
Authorization: Bearer {{token}}

### Get Specific Command Info
GET {{base_url}}/api/v1/command/list_file/info
Authorization: Bearer {{token}}

### Execute disk_report Command (JSON output — object)
# Declares `output_format: "json"`, so the poll below may ask for ?format=json.
# @name my_command
POST {{base_url}}/api/v1/command/execution
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "command_name": "disk_report",
    "host": "localhost",
    "port": 2222,
    "username": "root",
    "ssh_config": "cluster1",
    "option": {
        "timeout_seconds": 30
    },
    "arguments": {}
}

### Execute net_info Command (JSON output — top-level array)
# `ip -j` emits JSON natively. output_json is typed Any, so an array payload
# is just as valid as an object.
POST {{base_url}}/api/v1/command/execution
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "command_name": "net_info",
    "host": "localhost",
    "port": 2222,
    "username": "root",
    "ssh_config": "cluster1",
    "option": {
        "timeout_seconds": 30
    },
    "arguments": {}
}

### Execute pwd Command
# @name my_command
POST {{base_url}}/api/v1/command/execution
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "command_name": "sleep",
    "host": "localhost",
    "port": 2222,
    "username": "root",
    "ssh_config": "cluster1",
    "option": {
        "timeout_seconds": 600
    },
    "arguments": {
        "time": "123"
    }
}

### Execute pwd Command
# @name my_command
POST {{base_url}}/api/v1/command/execution
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "command_name": "list_file",
    "host": "localhost",
    "port": 2222,
    "username": "root",
    "ssh_config": "cluster1",
    "option": {
        "timeout_seconds": 60
    },
    "arguments": {
        "key_word": ".*",
        "key_word2": "bash"
    }
}

### Execute test_injection Command
# @name my_command
POST {{base_url}}/api/v1/command/execution
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "command_name": "reboot",
    "host": "localhost",
    "port": 2222,
    "username": "root",
    "ssh_config": "cluster1",
    "option": {
        "timeout_seconds": 60
    },
    "arguments": {}
}


### Execute whoami via Bastion (bastion_type auto-derived from BASTION_NODE_TYPE_MAP)
# @name my_command
POST {{base_url}}/api/v1/command/execution
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "command_name": "whoami",
    "host": "node-001",
    "host_type": "bastion",
    "port": 22,
    "username": "root",
    "ssh_config": "cluster1",
    "option": {
        "timeout_seconds": 30
    },
    "arguments": {}
}

### Execute whoami via Bastion (bastion_type explicitly set, overrides BASTION_NODE_TYPE_MAP)
# @name my_command
POST {{base_url}}/api/v1/command/execution
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "command_name": "whoami",
    "host": "node-001",
    "host_type": "bastion",
    "port": 22,
    "username": "root",
    "ssh_config": "cluster1",
    "option": {
        "timeout_seconds": 30,
        "bastion_type": "type1"
    },
    "arguments": {}
}


### Poll Execution Status (raw — the default, works for every command)
@my_command_id = {{my_command.response.body.data.command_id}}

GET {{base_url}}/api/v1/command/execution/{{my_command_id}}
Authorization: Bearer {{token}}

### Poll Execution Status (parsed — JSON-capable commands only)
# `output_json` carries the parsed stdout; `output` keeps its raw string either
# way. Only accepted when the command's whitelist entry declares
# `output_format: "json"` (disk_report, net_info) — asking for it on a text
# command such as sleep or list_file is a 400.
GET {{base_url}}/api/v1/command/execution/{{my_command_id}}?format=json
Authorization: Bearer {{token}}

### Kill command
@my_command_id = {{my_command.response.body.data.command_id}}

POST {{base_url}}/api/v1/command/execution/{{my_command_id}}/kill
Authorization: Bearer {{token}}